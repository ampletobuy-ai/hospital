# Production — https://hospital.qubextrack.com
# Copy to /opt/hospital/.env on the production VPS (129.121.125.118).
HOSPITAL_HOST=hospital.qubextrack.com
HOSPITAL_BASE_URL=https://hospital.qubextrack.com/
HOSPITAL_IMAGE_TAG=latest
HOSPITAL_FOLDER_PATH=/var/www/html/

# Tenant app database (template) on platform-mysql
DB_HOST=platform-mysql
DB_PORT=3306
DB_USERNAME=hospital
DB_PASSWORD=CHANGE_ME
DB_DATABASE=hospital

# Shared central control plane (same as retail-pos / hotel)
DB_CENTRAL_HOST=platform-mysql
DB_CENTRAL_PORT=3306
DB_CENTRAL_USERNAME=CHANGE_ME
DB_CENTRAL_PASSWORD=CHANGE_ME
DB_CENTRAL_DATABASE=trackpossystem

TENANCY_ENABLED=true
MULTI_TENANT_LOGIN=true
TENANCY_PRODUCT_CODE=hospital
TENANT_DATABASE_PREFIX=hospital_
TENANT_TEMPLATE_DATABASE=hospital
TENANT_TEMPLATE_DATA_COPY_MODE=blacklist

HOSPITAL_SAAS_REGISTER=true
SAAS_ENABLED=true
PORTAL_RAZORPAY_ALLOW_LOCAL_ORDERS=false

# Required for registration pending-signup password encryption (openssl rand -base64 32)
PORTAL_SIGNUP_CRYPT_KEY=base64:CHANGE_ME_TO_32_BYTE_KEY_BASE64==
