# Hospital app — multi-tenant (shared central DB with retail-pos)
# Copy to .env and adjust for your environment.

# Tenant app database (template / golden schema)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=hospital

# Shared central control plane (same as retail-pos)
DB_CENTRAL_HOST=localhost
DB_CENTRAL_PORT=3306
DB_CENTRAL_USERNAME=root
DB_CENTRAL_PASSWORD=
DB_CENTRAL_DATABASE=trackpossystem

# Tenancy
TENANCY_ENABLED=true
MULTI_TENANT_LOGIN=true
TENANCY_PRODUCT_CODE=hospital
TENANT_DATABASE_PREFIX=hospital_
TENANT_TEMPLATE_DATABASE=hospital

# Template master-data copy: blacklist (default) copies all tables except transactional ones.
# Set to whitelist to use the legacy copy_template_data_tables list only.
TENANT_TEMPLATE_DATA_COPY_MODE=blacklist

# Portal integration
PORTAL_REGISTER_URL=http://localhost/retail-pos/public/portal/register?product=hospital
PORTAL_SUBSCRIPTION_URL=http://localhost/retail-pos/public/portal/subscription
# Shared with retail-pos / bookingengine (Laravel Encrypter key). Required for paid pending passwords.
PORTAL_SIGNUP_CRYPT_KEY=base64:CHANGE_ME_TO_32_BYTE_KEY_BASE64==

# In-app SaaS register (bookingengine-style). When false, site/register redirects to PORTAL_REGISTER_URL.
HOSPITAL_SAAS_REGISTER=true
PORTAL_OTP_LENGTH=6
PORTAL_OTP_TTL_MINUTES=10
PORTAL_OTP_MAX_ATTEMPTS=5
PORTAL_OTP_VERIFICATION_TTL_MINUTES=30
PORTAL_BILLING_GST_RATE=0.18
PORTAL_BILLING_CURRENCY=INR
PORTAL_RAZORPAY_KEY_ID=
PORTAL_RAZORPAY_KEY_SECRET=
PORTAL_RAZORPAY_ALLOW_LOCAL_ORDERS=true

# SaaS quotas (enabled automatically when TENANCY_ENABLED=true)
SAAS_ENABLED=true

# Local install defaults (legacy single-tenant / bootstrap)
HOSPITAL_BASE_URL=http://localhost/hospital/
HOSPITAL_FOLDER_PATH=/Applications/XAMPP/xamppfiles/htdocs/hospital/
HOSPITAL_ADMIN_EMAIL=ampletobuy@gmail.com
HOSPITAL_ADMIN_PASSWORD=admin123
