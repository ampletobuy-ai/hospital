# Hospital app — multi-tenant (shared central DB with retail-pos)
# Copy to .env and adjust for your environment.

# Tenant app database (template / golden schema)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=hospital

# Shared central control plane (same as retail-pos)
DB_CENTRAL_HOST=localhost
DB_CENTRAL_PORT=3306
DB_CENTRAL_USERNAME=root
DB_CENTRAL_PASSWORD=
DB_CENTRAL_DATABASE=trackpossystem

# Tenancy
TENANCY_ENABLED=false
MULTI_TENANT_LOGIN=true
TENANCY_PRODUCT_CODE=hospital
TENANT_DATABASE_PREFIX=hospital_
TENANT_TEMPLATE_DATABASE=hospital

# Portal integration
PORTAL_REGISTER_URL=http://localhost/retail-pos/public/portal/register?product=hospital
PORTAL_SUBSCRIPTION_URL=http://localhost/retail-pos/public/portal/subscription
PORTAL_SIGNUP_CRYPT_KEY=

# SaaS quotas (enabled automatically when TENANCY_ENABLED=true)
SAAS_ENABLED=false

# Local install defaults (legacy single-tenant / bootstrap)
HOSPITAL_BASE_URL=http://localhost/hospital/
HOSPITAL_FOLDER_PATH=/Applications/XAMPP/xamppfiles/htdocs/hospital/
HOSPITAL_ADMIN_EMAIL=ampletobuy@gmail.com
HOSPITAL_ADMIN_PASSWORD=admin123
